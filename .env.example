# Copy to .env.local for development. Set the same keys in Vercel (production + preview).
# Secrets never go in the repo. See docs/implementation-guide.md for who supplies each value.

# --- Database (M1) ---
# Neon pooled connection string, used by the app at runtime.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
# Neon direct (unpooled) connection string, used by Prisma migrations.
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"
# Optional: a separate, migrated database for the Postgres-backed tests
# (src/**/*.db.test.ts). Those tests are skipped when this is unset.
TEST_DATABASE_URL=""
# Local alternative to Neon with no system install: `pnpm db:local` runs an
# embedded Postgres on port 54329 (data in ./.local/pg). Then use:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:54329/chef_bnb_dev"
#   DIRECT_URL="postgresql://postgres:postgres@localhost:54329/chef_bnb_dev"
#   TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:54329/chef_bnb_test"

# --- Auth (M2) ---
# Session encryption key. Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Placeholder email-only sign-in (no password). On by default in development and
# Vercel previews, off in production. "true" forces it on, "false" forces it off.
AUTH_DEV_LOGIN=""
# Google OAuth client (Google Cloud console -> Credentials -> OAuth client ID, Web).
# Not wired up yet — checklist item 4.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Comma-separated emails that get the admin role on sign-in.
ADMIN_EMAILS=""
# Comma-separated phone numbers (any format, US assumed) that get the admin role on phone sign-in.
ADMIN_PHONES=""

# --- Phone sign-in + texts (Twilio) ---
# Console, Account Info: Account SID and Auth Token (or an API key SID/secret pair).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Verify, Services, Create ("Covers"): sends and checks login codes. Needs no carrier registration.
# Without it, phone sign-in uses the console: any number, code 000000, outside production only.
TWILIO_VERIFY_SERVICE_SID=""
# Messaging, Services: a Messaging Service with a US number and A2P 10DLC registration approved.
# Turns on notification texts (confirmations, address reveal); until then those print to the console
# for phone-only users and go by email for everyone else.
TWILIO_MESSAGING_SERVICE_SID=""
# Canonical URL, used for links in emails. Vercel URL now, real domain later.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Shown on the terms and privacy pages as the contact address. Leave unset until the mailbox exists.
NEXT_PUBLIC_SUPPORT_EMAIL=""

# --- Files (M3) ---
# Vercel Blob. Auto-set in Vercel once Blob is enabled; copy it here for local dev.
BLOB_READ_WRITE_TOKEN=""

# --- Maps (M5) ---
# Mapbox public token.
NEXT_PUBLIC_MAPBOX_TOKEN=""

# --- Email + jobs (M7) ---
RESEND_API_KEY=""
# Sender address; needs a verified domain in Resend.
EMAIL_FROM="hello@example.com"
# Shared secret the /api/cron route requires. Generate with: openssl rand -base64 32
# Vercel Cron sends it as "Authorization: Bearer <value>" on its own once it is set in the project.
CRON_SECRET=""

# --- Errors (M9, optional) ---
SENTRY_DSN=""
