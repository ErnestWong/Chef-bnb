# Copy to .env.local for development. Set the same keys in Vercel (production + preview).
# Secrets never go in the repo. See docs/implementation-guide.md for who supplies each value.

# --- Database (M1) ---
# Neon pooled connection string, used by the app at runtime.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
# Neon direct (unpooled) connection string, used by Prisma migrations.
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"
# Optional: a separate, migrated database for the Postgres-backed tests
# (src/**/*.db.test.ts). Those tests are skipped when this is unset.
TEST_DATABASE_URL=""

# --- Auth (M2) ---
# Session encryption key. Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Placeholder email-only sign-in (no password). On by default in development and
# Vercel previews, off in production. "true" forces it on, "false" forces it off.
AUTH_DEV_LOGIN=""
# Google OAuth client (Google Cloud console -> Credentials -> OAuth client ID, Web).
# Not wired up yet — checklist item 4.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Comma-separated emails that get the admin role on sign-in.
ADMIN_EMAILS=""
# Canonical URL, used for links in emails. Vercel URL now, real domain later.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Files (M3) ---
# Vercel Blob. Auto-set in Vercel once Blob is enabled; copy it here for local dev.
BLOB_READ_WRITE_TOKEN=""

# --- Maps (M5) ---
# Mapbox public token.
NEXT_PUBLIC_MAPBOX_TOKEN=""

# --- Email + jobs (M7) ---
RESEND_API_KEY=""
# Sender address; needs a verified domain in Resend.
EMAIL_FROM="hello@example.com"
# Shared secret the /api/cron route requires. Generate with: openssl rand -base64 32
CRON_SECRET=""

# --- Errors (M9, optional) ---
SENTRY_DSN=""
